# Telegram Bot Token (from @BotFather)
BOT_TOKEN=REPLACE_ME

# Archive channel/group id (e.g. -1001234567890) — must be PRIVATE
CHANNEL_ID=REPLACE_ME

# First owner user_id (added manually once). Find via @userinfobot
OWNER_ID=REPLACE_ME

# Optional: AI provider & keys (also settable interactively via /setai on the bot).
# Provider: 'gemini' (default) | 'openai' | 'local'
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
